{{#each this}}
<h2 class="title">{{names.common}}</h2>
<div class="container">
    <div>
        {{#with capitals.[0]}}
            <p><b>Capital:</b> {{name}}</p>
        {{/with}}
        <p><b>Population:</b> {{population}}</p>
        <p><b>Languages:</b></p>
        <ul>
            {{#each languages}}
            <li>{{name}}</li>
            {{/each}}
        </ul>
    </div>
    <img src={{flag.url_png}} alt={{flag.description}} width="200" height="150">
</div>
{{/each}}