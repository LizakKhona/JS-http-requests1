{{#each this}}
<h2>{{names.common}}</h2>
<div>
    <div>
        <p>Capital: {{capitals[0].name}}</p>
        <p>Population: {{population}}</p>
        <ul>
            {{#each languages}}
            <li>{{name}}</li>
            {{/each}}
        </ul>
    </div>
    <img src={{flag.url_png}} alt={{flag.description}} width="200" height="150">
</div>
{{}}